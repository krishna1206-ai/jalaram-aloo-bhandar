# Copy this file to server/.env and fill it in. Never commit the real .env.

# development | production
NODE_ENV=development
PORT=5000
APP_NAME=Jalaram Aloo Bhandar

# MongoDB connection string, e.g. from MongoDB Atlas (free M0 cluster works).
# Leave empty in development to use a temporary in-memory database (data is lost on restart).
MONGODB_URI=

# Long random string used to sign login tokens. Required in production (32+ characters).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encrypts PAN and bank account numbers. Required in production: exactly 64 hex characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a safe copy. If it is lost or changed, encrypted data can't be read.
DATA_KEY=

# Frontend URL(s) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Admin account created on first start. Required in production (password 10+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# Load demo users, orders and wallet requests (and allow "Reset demo data"). Default: true in development, false in production.
SEED_DEMO=true

# Dev OTP mode: OTP is always 123456 and nothing is sent. Default: true in development, false in production.
# Set to false once email (SMTP) and SMS below are filled in.
OTP_DEV_MODE=true

# ---------- Your collection account (shown for manual UPI / bank transfer deposits) ----------
# Required in production.
COLLECT_ACCOUNT_NAME=Jalaram Aloo Bhandar Collections
COLLECT_ACCOUNT_NUMBER=
COLLECT_ACCOUNT_IFSC=
COLLECT_ACCOUNT_BANK=
COLLECT_UPI_ID=

# ---------- Email (OTP to email, and notifications) ----------
# Any SMTP service. Gmail: smtp.gmail.com, port 465, your address + an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- SMS (OTP to mobile) ----------
# msg91 (needs a DLT-approved OTP template with the ##OTP## variable) or twilio
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Online payments (Razorpay) ----------
# Dashboard → Account & Settings → API Keys. Leave empty to offer only manual UPI / bank transfer.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://YOUR-API/api/webhooks/razorpay with events
# payment.captured and payment.failed, and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=

# Number of proxies in front of the API (Render/Railway/Nginx = 1). Default: 1 in production, 0 in development.
# TRUST_PROXY=1
